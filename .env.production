# Cast-POS Production Configuration

# Deployment
NEXT_PUBLIC_URL=https://your-app.vercel.app

# Base Sepolia Configuration
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MERCHANT_ADDRESS=0xYourMerchantWallet
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_RESERVE_ADDRESS=0xYourReserveWallet
NEXT_PUBLIC_BLOCK_EXPLORER=https://sepolia.basescan.org

# Farcaster Integration
NEXT_PUBLIC_FARCASTER_HEADER=<generated-via-warpcast>
NEXT_PUBLIC_FARCASTER_PAYLOAD=<generated-via-warpcast>
NEXT_PUBLIC_FARCASTER_SIGNATURE=<generated-via-warpcast>
NEYNAR_API_KEY=<your-neynar-api-key>

# Authentication
JWT_SECRET=<random-256-bit-secret>

# Redis
REDIS_URL=<your-redis-url>
REDIS_TOKEN=<your-redis-token>
